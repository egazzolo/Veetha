{
  "cli": {
    "version": ">= 16.20.3",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "preview",
      "prebuildCommand": "npx expo prebuild --clean"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "prebuildCommand": "npx expo prebuild --clean"    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
