{
  "cli": {
    "version": ">= 16.20.3",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "android": {
        "prebuildCommand": "npx expo prebuild --platform android --clean"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
