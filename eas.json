{
  "cli": {
    "version": ">= 16.20.3",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "prebuildCommand": "npx expo prebuild --clean && sed -i '' 's/CLANG_CXX_LANGUAGE_STANDARD = \"c++20\"/CLANG_CXX_LANGUAGE_STANDARD = \"c++17\"/g' ios/Pods/Pods.xcodeproj/project.pbxproj || true"
    }
  },
  "submit": {
    "production": {}
  }
}
